        <mxCell id="device" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;«entity / aggregate root»&lt;/b&gt;&lt;br&gt;&lt;b&gt;IntersectionDevice&lt;/b&gt;&lt;hr&gt;− Serial : SerialNumber &amp;lt;&amp;lt;identity&amp;gt;&amp;gt;&lt;br&gt;− DisplayName : string&lt;br&gt;− NorthSouthVehicle : VehicleSignalState&lt;br&gt;− EastWestVehicle : VehicleSignalState&lt;br&gt;− NorthSouthPedestrian : PedestrianSignalState&lt;br&gt;− EastWestPedestrian : PedestrianSignalState&lt;br&gt;− Status : DeviceLifecycle&lt;hr&gt;+ Register(serial, name) : IntersectionDevice&lt;br&gt;+ ChangePhase(approach, nextState)&lt;br&gt;+ StartAdvancedGreen(approach)&lt;br&gt;+ SetPedestrian(approach, nextState)&lt;br&gt;+ Deactivate() / Activate()&lt;hr&gt;&lt;i&gt;Invariants:&lt;/i&gt; serial mask; NS Green or AdvancedGreen forces EW Red + DontWalk (and reverse); no Green↔Red skip of Yellow; at most one enabled SignalRule per Approach" vertex="1">
          <mxGeometry height="360" width="400" x="40" y="250" as="geometry" />
        </mxCell>
        <mxCell id="rule" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;«entity»&lt;/b&gt;&lt;br&gt;&lt;b&gt;SignalRule&lt;/b&gt;&lt;hr&gt;− DeviceSerial : SerialNumber&lt;br&gt;− Approach : Approach&lt;br&gt;− MinGreenSeconds : int&lt;br&gt;− MaxGreenSeconds : int&lt;br&gt;− YellowSeconds : int&lt;br&gt;− AdvancedGreenSeconds : int&lt;br&gt;− CountOverrideThreshold : int&lt;br&gt;− IsEnabled : bool&lt;hr&gt;+ Create(...) : SignalRule&lt;br&gt;+ ShouldOverride(telemetry) : bool&lt;br&gt;+ NextState(current, elapsed) : VehicleSignalState&lt;hr&gt;&lt;i&gt;Invariants:&lt;/i&gt;&amp;nbsp;identified by DeviceSerial + Apprioach; all durations &amp;gt; 0; MinGreen ≤ MaxGreen; only the enabled rule for this Approach is used" vertex="1">
          <mxGeometry height="300" width="340" x="620" y="250" as="geometry" />
        </mxCell>
        <mxCell id="telemetry" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;«entity»&lt;/b&gt;&lt;br&gt;&lt;b&gt;TrafficTelemetry&lt;/b&gt;&lt;hr&gt;− DeviceSerial : SerialNumber&lt;br&gt;− RecordedAt : DateTimeOffset&lt;br&gt;− Approach : Approach&lt;br&gt;− VehicleCount : int&lt;br&gt;− SpeedKph : decimal&lt;hr&gt;+ Record(device, approach, count, speed) : TrafficTelemetry&lt;hr&gt;&lt;i&gt;Invariants:&lt;/i&gt; count ≥ 0; speed &amp;gt; 0" vertex="1">
          <mxGeometry height="210" width="340" x="620" y="590" as="geometry" />
        </mxCell>
        <mxCell id="violation" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;«entity»&lt;/b&gt;&lt;br&gt;&lt;b&gt;ViolationLog&lt;/b&gt;&lt;hr&gt;− DeviceSerial : SerialNumber&lt;br&gt;− OccurredAt : DateTimeOffset&lt;br&gt;− Type : ViolationType&lt;br&gt;− Plate : string?&lt;br&gt;− SpeedKph : decimal?&lt;br&gt;− SignalAtTime : VehicleSignalState&lt;hr&gt;+ LogRedLight(...) : ViolationLog&lt;br&gt;+ LogSpeeding(...) : ViolationLog&lt;hr&gt;One class, two types — not two classes. Identified by DeviceSerial + OccuredAt + Type." vertex="1">
          <mxGeometry height="230" width="340" x="620" y="840" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Legend&lt;/b&gt; (seed examples, not a city inventory)&lt;br&gt;INT-001  Paris St &amp;amp; Cedar St&lt;br&gt;INT-002  Paris St &amp;amp; John St&lt;br&gt;INT-003  Paris St toward Van Horne / Bridge of Nations&lt;br&gt;CAM-00n  camera on the matching INT-00n&lt;br&gt;&lt;br&gt;Gray = value object / enum&lt;br&gt;Blue = domain entity&lt;br&gt;Hollow diamond = aggregation (device owns related records)" vertex="1">
