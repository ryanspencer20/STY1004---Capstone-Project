        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1" value="Domain Model — Downtown Traffic Light Camera Architecture" vertex="1">
