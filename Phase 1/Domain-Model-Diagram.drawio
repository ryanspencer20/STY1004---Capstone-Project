  <diagram id="domain-model" name="IoT Platform Domain Model">
    <mxGraphModel dx="1477" dy="1108" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1600" math="0" shadow="0">
