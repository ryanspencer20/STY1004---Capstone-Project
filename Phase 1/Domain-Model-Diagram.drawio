        <mxCell id="serial" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;«value object»&lt;/b&gt;&lt;br&gt;&lt;b&gt;SerialNumber&lt;/b&gt;&lt;hr&gt;Value : string&lt;hr&gt;Parse(raw) : SerialNumber&lt;br&gt;Must match INT-### or CAM-###" vertex="1">
          <mxGeometry height="118" width="210" x="40" y="84" as="geometry" />
        </mxCell>
        <mxCell id="vstate" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;«enumeration»&lt;/b&gt;&lt;br&gt;&lt;b&gt;VehicleSignalState&lt;/b&gt;&lt;hr&gt;Red&lt;br&gt;Yellow&lt;br&gt;Green&lt;br&gt;AdvancedGreen" vertex="1">
          <mxGeometry height="118" width="170" x="270" y="84" as="geometry" />
        </mxCell>
        <mxCell id="pstate" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;«enumeration»&lt;/b&gt;&lt;br&gt;&lt;b&gt;PedestrianSignalState&lt;/b&gt;&lt;hr&gt;Walk&lt;br&gt;FlashingDontWalk&lt;br&gt;DontWalk" vertex="1">
          <mxGeometry height="118" width="180" x="460" y="84" as="geometry" />
        </mxCell>
        <mxCell id="approach" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;«enumeration»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Approach&lt;/b&gt;&lt;hr&gt;NorthSouth&lt;br&gt;EastWest" vertex="1">
          <mxGeometry height="118" width="140" x="660" y="84" as="geometry" />
        </mxCell>
        <mxCell id="facing" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;«enumeration»&lt;/b&gt;&lt;br&gt;&lt;b&gt;FacingDirection&lt;/b&gt;&lt;hr&gt;North&lt;br&gt;South&lt;br&gt;East&lt;br&gt;West" vertex="1">
          <mxGeometry height="118" width="150" x="820" y="84" as="geometry" />
        </mxCell>
        <mxCell id="vtype" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;«enumeration»&lt;/b&gt;&lt;br&gt;&lt;b&gt;ViolationType&lt;/b&gt;&lt;hr&gt;RedLight&lt;br&gt;Speeding" vertex="1">
          <mxGeometry height="118" width="150" x="990" y="84" as="geometry" />
        </mxCell>
        <mxCell id="life" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;«enumeration»&lt;/b&gt;&lt;br&gt;&lt;b&gt;DeviceLifecycle&lt;/b&gt;&lt;hr&gt;Commissioned&lt;br&gt;Active&lt;br&gt;Degraded&lt;br&gt;Decommissioned" vertex="1">
          <mxGeometry height="118" width="180" x="1160" y="84" as="geometry" />
        </mxCell>
        <mxCell id="location" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;«entity / aggregate root»&lt;/b&gt;&lt;br&gt;&lt;b&gt;IntersectionLocation&lt;/b&gt;&lt;hr&gt;− LocationSerial : SerialNumber  «identity»  (INT-)&lt;br&gt;− LocationName : string&lt;br&gt;− Latitude : double&lt;br&gt;− Longitude : double&lt;br&gt;− NorthSouthVehicle : VehicleSignalState&lt;br&gt;− EastWestVehicle : VehicleSignalState&lt;br&gt;− NorthSouthPedestrian : PedestrianSignalState&lt;br&gt;− EastWestPedestrian : PedestrianSignalState&lt;br&gt;− SignalStateTimestamp : DateTime&lt;br&gt;− Rules : IReadOnlyList&amp;lt;SignalRule&amp;gt;&lt;hr&gt;+ Register(locationSerial, name, lat, lon)&lt;br&gt;+ Restore(...) : IntersectionLocation&lt;br&gt;+ ChangePhase(approach, nextState)&lt;br&gt;+ StartAdvancedGreen(approach)&lt;br&gt;+ SetPedestrian(approach, nextState)&lt;br&gt;+ AddRule(rule)&lt;hr&gt;&lt;i&gt;Invariants:&lt;/i&gt; NS Green or AdvancedGreen forces EW Red + DontWalk (and reverse); no Green↔Red skip of Yellow; at most one SignalRule per Approach" vertex="1">
          <mxGeometry height="380" width="420" x="40" y="230" as="geometry" />
        </mxCell>
        <mxCell id="device" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;«entity»&lt;/b&gt;&lt;br&gt;&lt;b&gt;IntersectionDevice&lt;/b&gt;&lt;hr&gt;− Serial : SerialNumber  «identity»  (CAM-)&lt;br&gt;− LocationSerial : SerialNumber  (INT-)&lt;br&gt;− DisplayName : string&lt;br&gt;− FacingDirection : FacingDirection&lt;br&gt;− FirmwareVersion : string&lt;br&gt;− CommissionedDate : DateTime&lt;br&gt;− Status : DeviceLifecycle&lt;hr&gt;+ Register(serial, location, name, facing, firmware)&lt;br&gt;+ Restore(...) : IntersectionDevice&lt;br&gt;+ Activate() / Deactivate()&lt;hr&gt;Camera/hardware at a location. Swap the camera, INT- stays." vertex="1">
          <mxGeometry height="280" width="380" x="540" y="250" as="geometry" />
        </mxCell>
        <mxCell id="rule" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;«entity»&lt;/b&gt;&lt;br&gt;&lt;b&gt;SignalRule&lt;/b&gt;&lt;hr&gt;− LocationSerial : SerialNumber&lt;br&gt;− Approach : Approach&lt;br&gt;− MinGreenSeconds : int&lt;br&gt;− MaxGreenSeconds : int&lt;br&gt;− YellowSeconds : int&lt;br&gt;− AdvancedGreenSeconds : int&lt;br&gt;− CountOverrideThreshold : int&lt;br&gt;− IsEnabled : bool&lt;hr&gt;+ Create(...) : SignalRule&lt;br&gt;+ ShouldOverride(telemetry) : bool&lt;br&gt;+ NextState(current, elapsed) : VehicleSignalState&lt;hr&gt;&lt;i&gt;Invariants:&lt;/i&gt; identified by LocationSerial + Approach; all durations &gt; 0; MinGreen ≤ MaxGreen; only the enabled rule for this Approach is used" vertex="1">
          <mxGeometry height="300" width="360" x="980" y="230" as="geometry" />
        </mxCell>
        <mxCell id="telemetry" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;«entity»&lt;/b&gt;&lt;br&gt;&lt;b&gt;TrafficTelemetry&lt;/b&gt;&lt;hr&gt;− DeviceSerial : SerialNumber  (CAM-)&lt;br&gt;− RecordedAt : DateTimeOffset&lt;br&gt;− Approach : Approach&lt;br&gt;− VehicleCount : int&lt;br&gt;− SpeedKph : decimal&lt;hr&gt;+ Record(device, approach, count, speed)&lt;br&gt;+ Restore(...) : TrafficTelemetry&lt;hr&gt;&lt;i&gt;Invariants:&lt;/i&gt; identified by DeviceSerial + RecordedAt + Approach; count ≥ 0; speed &gt; 0" vertex="1">
          <mxGeometry height="230" width="380" x="520" y="650" as="geometry" />
        </mxCell>
        <mxCell id="violation" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;«entity»&lt;/b&gt;&lt;br&gt;&lt;b&gt;ViolationLog&lt;/b&gt;&lt;hr&gt;− DeviceSerial : SerialNumber  (CAM-)&lt;br&gt;− OccurredAt : DateTimeOffset&lt;br&gt;− Type : ViolationType&lt;br&gt;− Plate : string?&lt;br&gt;− SpeedKph : decimal?&lt;br&gt;− SignalAtTime : VehicleSignalState&lt;hr&gt;+ LogRedLight(...) : ViolationLog&lt;br&gt;+ LogSpeeding(...) : ViolationLog&lt;hr&gt;One class, two types. Identified by DeviceSerial + OccurredAt + Type." vertex="1">
          <mxGeometry height="240" width="360" x="980" y="640" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Legend&lt;/b&gt; — no numeric IDs&lt;br&gt;&lt;br&gt;&lt;b&gt;INT- (LocationSerial)&lt;/b&gt;&amp;nbsp;&amp;nbsp;the place; stays if camera is swapped&lt;br&gt;INT-001&amp;nbsp;&amp;nbsp;Paris St &amp; Cedar St&lt;br&gt;INT-002&amp;nbsp;&amp;nbsp;Paris St &amp; John St&lt;br&gt;INT-003&amp;nbsp;&amp;nbsp;Paris St toward Van Horne / Bridge of Nations&lt;br&gt;&lt;br&gt;&lt;b&gt;CAM- (Device Serial)&lt;/b&gt;&amp;nbsp;&amp;nbsp;the camera/hardware at that location&lt;br&gt;CAM-001 sits at INT-001, etc.&lt;br&gt;&lt;br&gt;Gray = value object / enum&lt;br&gt;Blue = domain entity&lt;br&gt;Lights and timing rules live on Location.&lt;br&gt;Counts and tickets live on Device." vertex="1">
          <mxGeometry height="250" width="420" x="40" y="640" as="geometry" />
        </mxCell>
